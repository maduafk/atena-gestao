# ============================================
# CONFIGURAÇÃO DE AMBIENTE - ATENA GESTÃO
# ============================================
# Copie este arquivo para .env e preencha os valores

# ============================================
# DATABASE
# ============================================
# URL de conexão com PostgreSQL
# Em produção, use a URL do seu provedor (Neon, Supabase, etc)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atena-db?schema=public"

# ============================================
# AUTENTICAÇÃO (OBRIGATÓRIO EM PRODUÇÃO)
# ============================================
# Gere uma chave segura com: openssl rand -base64 32
# NUNCA use a chave padrão em produção!
# Mínimo recomendado: 32 caracteres
AUTH_SECRET="gere-uma-chave-segura-com-openssl-rand-base64-32"

# ============================================
# APLICAÇÃO
# ============================================
# URL da aplicação (usado para links absolutos)
# Em produção: https://seu-dominio.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ambiente: development | production
NODE_ENV="development"

# ============================================
# EMAIL (OBRIGATÓRIO PARA AUTENTICAÇÃO)
# ============================================
# API Key do Resend (resend.com - 100 emails/dia grátis)
RESEND_API_KEY="re_sua_api_key_aqui"

# Email de origem (em dev use onboarding@resend.dev)
# Em produção, configure seu domínio no Resend
EMAIL_FROM="Atena <onboarding@resend.dev>"

# ============================================
# TELEGRAM BOT (OPCIONAL - para integração futura)
# ============================================
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""
